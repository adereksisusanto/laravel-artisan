{
    "name": "adereksisusanto/laravel-artisan",
    "description": "Laravel scaffolding toolkit – generate boilerplate code and build artisan-powered CLI tools.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "artisan",
        "laravel",
        "scaffold",
        "generator",
        "boilerplate",
        "code-generator",
        "artisan-commands",
        "package-development",
        "laravel-package",
        "php"
    ],
    "authors": [
        {
            "name": "Ade Reksi Susanto",
            "email": "adereksisusanto@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3|^8.5",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/container": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "symfony/console": "^6.0|^7.0|^8.0",
        "symfony/finder": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Adereksisusanto\\Laravel\\Artisan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Adereksisusanto\\Laravel\\Artisan\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Adereksisusanto\\Laravel\\Artisan\\Providers\\ArtisanServiceProvider"
            ]
        }
    },
    "bin": [
        "bin/artisan"
    ],
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse",
        "analyse:baseline": "phpstan analyse --generate-baseline",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
